<%- include('partials/header', { title: 'Edit post' }) %>
<div class="row justify-content-center">
  <div class="col-lg-8">
    <div class="card">
      <div class="card-body p-4">
        <h1 class="h3 mb-3">Edit post</h1>
        <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
        <form action="/posts/<%= post.blog_id %>/edit" method="POST">
          <div class="mb-3">
            <label for="title" class="form-label">Title</label>
            <input type="text" class="form-control" id="title" name="title" maxlength="255" value="<%= post.title %>" required>
          </div>
          <div class="mb-3">
            <label for="body" class="form-label">Body</label>
            <textarea class="form-control" id="body" name="body" rows="8" required><%= post.body %></textarea>
          </div>
          <div class="d-flex gap-2">
            <button type="submit" class="btn btn-dark">Save changes</button>
            <a href="/" class="btn btn-outline-secondary">Cancel</a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
<%- include('partials/footer') %>

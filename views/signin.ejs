<%- include('partials/header', { title: 'Sign in' }) %>
<div class="row justify-content-center">
  <div class="col-md-6 col-lg-5">
    <div class="card">
      <div class="card-body p-4">
        <h1 class="h3 mb-3">Sign in</h1>
        <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
        <form action="/signin" method="POST">
          <div class="mb-3">
            <label for="user_id" class="form-label">User ID</label>
            <input type="text" class="form-control" id="user_id" name="user_id" value="<%= form.user_id || '' %>" required autofocus>
          </div>
          <div class="mb-3">
            <label for="password" class="form-label">Password</label>
            <input type="password" class="form-control" id="password" name="password" required>
          </div>
          <button type="submit" class="btn btn-dark w-100">Sign in</button>
        </form>
        <p class="mt-3 mb-0 small">New here? <a href="/signup">Create an account</a></p>
      </div>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
